# Memex desktop — environment variables
# Copy to .env and adjust as needed: `cp .env.example .env`

# Tauri dev host (required for mobile / network dev)
# Set to your LAN IP when running `npm run tauri dev` on a device that needs network access.
# Example: 192.168.1.42  (leave empty for localhost-only)
TAURI_DEV_HOST=

# Vite / frontend
# Override dev server port if 1420 is already in use (Tauri expects 1420 by default)
# VITE_PORT=1420

# Rust / Tauri (optional)
# RUST_LOG=info
# TAURI_DEBUG=true
